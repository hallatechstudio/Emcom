{
  "name": "emcom",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter=@emcom/api --filter=@emcom/worker --filter=@emcom/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose up -d postgres redis s3 mailpit",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @emcom/api prisma:migrate",
    "db:seed": "pnpm --filter @emcom/api db:seed",
    "db:reset": "pnpm --filter @emcom/api db:reset",
    "api:dev": "pnpm --filter @emcom/api dev",
    "worker:dev": "pnpm --filter @emcom/worker dev",
    "web:dev": "pnpm --filter @emcom/web dev",
    "mobile:start": "pnpm --filter @emcom/mobile start",
    "openapi": "pnpm --filter @emcom/api openapi:generate"
  },
  "devDependencies": {
    "turbo": "2.5.8",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  }
}
