{
  "name": "@emcom/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest",
    "build": "echo 'Mobile binaries are built with EAS: npx eas build (see apps/mobile/README.md)'",
    "start:dev-client": "expo start --dev-client"
  },
  "dependencies": {
    "@emcom/api-client": "workspace:*",
    "@emcom/shared-types": "workspace:*",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "5.87.4",
    "@tanstack/react-query": "5.87.4",
    "@tanstack/react-query-persist-client": "5.87.4",
    "expo": "57.0.27",
    "expo-application": "~57.0.3",
    "expo-audio": "~57.0.5",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-hook-form": "7.62.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "6.3.15",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "socket.io-client": "4.8.1",
    "zod": "3.25.76",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.18",
    "expo-dev-client": "~57.0.19",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@emcom/.*)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
