{
  "expo": {
    "name": "EMCOM",
    "slug": "emcom",
    "scheme": "emcom",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.emcom.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "EMCOM uses the camera so you can attach a photo or video to an emergency report.",
        "NSPhotoLibraryUsageDescription": "EMCOM lets you attach a photo or video to an emergency report.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "EMCOM attaches your location to an emergency report only when you choose to, so responders can find you."
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.emcom.app",
      "adaptiveIcon": {
        "backgroundColor": "#C8102E"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C8102E",
          "defaultChannel": "emergency-alerts"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "EMCOM lets you attach a photo or video to an emergency report.",
          "cameraPermission": "EMCOM uses the camera so you can attach a photo or video to an emergency report."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "EMCOM uses the camera to scan your community's QR code and to attach photos to emergency reports.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EMCOM attaches your location to an emergency report only when you choose to, so responders can find you."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C8102E",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiBaseUrl": "",
      "eas": {
        "projectId": "101a1147-c1b8-47ba-a135-6b0b44788691"
      },
      "router": {}
    },
    "owner": "ikiloalerts"
  }
}
