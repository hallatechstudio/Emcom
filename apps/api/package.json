{
  "name": "@emcom/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "dev:worker": "nest start --watch --preserveWatchOutput --config nest-cli.worker.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "prisma generate >/dev/null && tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "jest --config test/jest.unit.config.js",
    "test:integration": "dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- jest --config test/jest.integration.config.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi:generate": "ts-node --transpile-only scripts/generate-openapi.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.700.0",
    "@aws-sdk/s3-request-presigner": "3.700.0",
    "@emcom/shared-types": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@nestjs/websockets": "11.1.6",
    "@prisma/client": "6.16.2",
    "@sentry/node": "9.47.1",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.41.1",
    "bullmq": "5.58.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.4.7",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "nestjs-pino": "4.4.0",
    "nodemailer": "6.10.1",
    "pino": "9.9.0",
    "pino-http": "10.5.0",
    "prisma": "6.16.2",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@emcom/config": "workspace:*",
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.7",
    "@nestjs/testing": "11.1.6",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "20.17.10",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.44.0",
    "@typescript-eslint/parser": "8.44.0",
    "dotenv-cli": "8.0.0",
    "eslint": "9.35.0",
    "jest": "29.7.0",
    "pino-pretty": "13.1.1",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.0"
  }
}
