# Used only by automated tests (`pnpm test`). Not secret: points at the local docker services.
NODE_ENV=test
LOG_LEVEL=silent
DATABASE_URL=postgresql://emcom:emcom_dev_password@localhost:5433/emcom_test?schema=public
REDIS_URL=redis://localhost:6380/1
JWT_ACCESS_SECRET=test-only-secret-test-only-secret-1234567890
MAIL_TRANSPORT=memory
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=emcom-media-test
S3_ACCESS_KEY_ID=emcom-s3-dev
S3_SECRET_ACCESS_KEY=emcom-s3-dev-secret
S3_AUTO_CREATE_BUCKET=true
PUSH_PROVIDERS=MOCK
OUTBOX_POLL_MS=50
SWAGGER_ENABLED=false
