# ---- EMCOM API / worker (local development defaults; copy to .env) ----
NODE_ENV=development
PORT=4000
WORKER_METRICS_PORT=9464
LOG_LEVEL=info

DATABASE_URL=postgresql://emcom:emcom_dev_password@localhost:5433/emcom?schema=public
REDIS_URL=redis://localhost:6380/0

# Admin web origin(s), comma separated
CORS_ORIGINS=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3001

# Generate with: openssl rand -base64 48   (never commit a real value)
JWT_ACCESS_SECRET=change-me-local-dev-only-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REQUIRE_EMAIL_VERIFICATION=true
OTP_TTL_MINUTES=10

# Mailpit catches all mail locally: http://localhost:8025
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="EMCOM <no-reply@emcom.local>"

# Local S3 (SeaweedFS from docker-compose). For a phone on Wi-Fi set S3_PUBLIC_ENDPOINT to http://<LAN-IP>:9000
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=emcom-media
S3_ACCESS_KEY_ID=emcom-s3-dev
S3_SECRET_ACCESS_KEY=emcom-s3-dev-secret
S3_FORCE_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

# Push: MOCK needs no credentials. Add EXPO and/or FCM for real devices (see docs/notification-strategy.md).
PUSH_PROVIDERS=MOCK,EXPO
PUSH_FORCE_MOCK=false
EXPO_ACCESS_TOKEN=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
PUSH_INCLUDE_DETAILS=true

# Critical alert abuse prevention (see docs/assumptions.md)
CRITICAL_ALERT_COALESCE_SECONDS=120
CRITICAL_ALERT_USER_LIMIT=3
CRITICAL_ALERT_USER_WINDOW_SECONDS=600

SENTRY_DSN=
METRICS_TOKEN=
SWAGGER_ENABLED=true
TRUST_PROXY=false
